# For running the backend outside Docker (npm run dev / npm run worker).
# Copy to backend/.env. Docker Compose doesn't use this file.

PORT=4000

# Works with the dev override, which exposes Postgres and Redis on localhost.
DATABASE_URL=postgresql://lookout:lookout@localhost:5432/lookout
REDIS_URL=redis://localhost:6379

# fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# Pretty logs for dev. pino-pretty isn't in the production image.
LOG_PRETTY=true

# Run the worker inside the api process. Only for hosts with one container (Render).
EMBED_WORKER=false

# 32+ chars, the api won't start otherwise. Make one with: openssl rand -base64 32
JWT_SECRET=change-this-to-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# Comma-separated. Signing up with one of these emails makes you an admin.
ADMIN_EMAILS=

CORS_ORIGIN=http://localhost:5173

# A check slower than this counts as a TIMEOUT.
CHECK_TIMEOUT_MS=10000

# Max checks running at once.
CHECK_CONCURRENCY=10

# Raw checks older than this get deleted. Hourly stats are kept.
CHECK_RETENTION_DAYS=7

# Only needed on IPv6-only networks.
# REDIS_FAMILY=0

# Root env for `docker compose up`. Copy to .env and set a real secret.
# The backend has its own backend/.env for host development (npm run dev).

# Must be at least 32 characters.
JWT_SECRET=change-this-to-a-random-string-of-at-least-32-characters

# Comma-separated. Users signing up with one of these emails get role ADMIN.
# The seed script also creates admin@lookout.dev as an ADMIN directly:
# ADMIN_EMAILS=admin@lookout.dev
ADMIN_EMAILS=

# Origin allowed by the API's CORS policy. With the nginx proxy the browser only
# ever talks to port 8080, so this is what it should be.
CORS_ORIGIN=http://localhost:8080

LOG_LEVEL=info
CHECK_TIMEOUT_MS=10000
CHECK_CONCURRENCY=10
CHECK_RETENTION_DAYS=7

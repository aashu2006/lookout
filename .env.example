# Root environment for `docker compose up`. Copy to .env before starting.
# (backend/.env is separate and only used for host development with npm run dev.)

# Signs and verifies JWTs. Must be at least 32 characters; the API refuses to
# start otherwise. Generate one with: openssl rand -base64 32
JWT_SECRET=change-this-to-a-random-string-of-at-least-32-characters

# Comma-separated list. A user signing up with one of these emails is created
# with role ADMIN, which unlocks /api/metrics and the cross-user URL view.
# The seed script separately creates admin@lookout.dev as an ADMIN directly.
ADMIN_EMAILS=

# Origin the API accepts cross-origin requests from. With the nginx proxy the
# browser only ever talks to port 8080, so this is the value to use.
CORS_ORIGIN=http://localhost:8080

# Log verbosity: fatal, error, warn, info, debug, trace, silent.
# At info, /health request logs are suppressed (they are emitted at debug).
LOG_LEVEL=info

# How long a single HTTP health check may take before it is recorded as TIMEOUT.
CHECK_TIMEOUT_MS=10000

# Maximum checks the worker runs at once, and the cap used by the check-all
# semaphore in the API.
CHECK_CONCURRENCY=10

# Raw check rows older than this are deleted by the daily prune job. Hourly
# aggregates in url_stats_hourly are kept indefinitely.
CHECK_RETENTION_DAYS=7

# Used by `docker compose up`. Copy to .env first.

# 32+ chars, the api won't start otherwise. Make one with: openssl rand -base64 32
JWT_SECRET=change-this-to-a-random-string-of-at-least-32-characters

# Comma-separated. Signing up with one of these emails makes you an admin.
ADMIN_EMAILS=

CORS_ORIGIN=http://localhost:8080

# fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# A check slower than this counts as a TIMEOUT.
CHECK_TIMEOUT_MS=10000

# Max checks running at once.
CHECK_CONCURRENCY=10

# Raw checks older than this get deleted. Hourly stats are kept.
CHECK_RETENTION_DAYS=7

# Only needed on IPv6-only networks.
# REDIS_FAMILY=0

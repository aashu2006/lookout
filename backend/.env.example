# Backend environment for host development (npm run dev / npm run worker).
# Copy to backend/.env. The Docker Compose stack does not read this file; it
# passes its own environment from the root .env.

# Port the Express API listens on.
PORT=4000

# Postgres connection string. Points at localhost because the dev override
# publishes the container's port:
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d postgres redis
DATABASE_URL=postgresql://lookout:lookout@localhost:5432/lookout

# Redis connection string, used for the BullMQ check and maintenance queues.
REDIS_URL=redis://localhost:6379

# Log verbosity: fatal, error, warn, info, debug, trace, silent.
# /health request logs are emitted at debug, so they are hidden at info.
LOG_LEVEL=info

# Human-readable coloured logs via pino-pretty. Development only: pino-pretty is
# a devDependency and is not present in the production image, which logs JSON.
LOG_PRETTY=true

# Signs and verifies JWTs. Must be at least 32 characters; startup fails
# otherwise. Generate one with: openssl rand -base64 32
JWT_SECRET=change-this-to-a-random-string-of-at-least-32-characters

# Token lifetime, in any format jsonwebtoken accepts (7d, 12h, 3600).
JWT_EXPIRES_IN=7d

# Comma-separated. Signing up with one of these emails grants role ADMIN.
ADMIN_EMAILS=

# Origin the API accepts cross-origin requests from. The Vite dev server proxies
# /api itself, so this matters only if you call the API from another origin.
CORS_ORIGIN=http://localhost:5173

# How long a single HTTP health check may take before it is recorded as TIMEOUT.
CHECK_TIMEOUT_MS=10000

# Maximum checks the worker runs at once, and the cap used by the check-all
# semaphore in the API.
CHECK_CONCURRENCY=10

# Raw check rows older than this are deleted by the daily prune job. Hourly
# aggregates in url_stats_hourly are kept indefinitely.
CHECK_RETENTION_DAYS=7
